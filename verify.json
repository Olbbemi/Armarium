{
  "rulesets": [
    "rules",
    "engine/meta-rules"
  ],
  "kinds": {
    "markdown": {
      "granularity": "file",
      "paths": [
        "core",
        "adapters",
        "rules",
        "engine/meta-rules",
        "skills",
        "CLAUDE.md",
        "README.md"
      ]
    },
    "ruleset": {
      "granularity": "dir",
      "from_rulesets": true
    },
    "procedure": {
      "granularity": "file",
      "paths": [
        "core",
        "skills"
      ]
    },
    "neutral": {
      "granularity": "file",
      "paths": [
        "core",
        "adapters",
        "rules",
        "engine/meta-rules"
      ]
    }
  },
  "verdicts": ".claude/verdicts.json",
  "names": {
    "skill": {
      "from_dirs": "skills"
    }
  },
  "timeout": 10
}
